#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-status}"
GPU_DEV="/sys/bus/platform/devices/fb000000.gpu"
GPU_OF="${GPU_DEV}/of_node"

hr() { echo; echo "===== $* ====="; }

dt_text_prop() {
  local prop="$1"
  [ -e "${GPU_OF}/${prop}" ] || return 1
  tr '\0' '\n' < "${GPU_OF}/${prop}"
}

dt_has_text() {
  local prop="$1" value="$2"
  dt_text_prop "${prop}" 2>/dev/null | grep -Fxq "${value}"
}

dt_has_prop() {
  [ -e "${GPU_OF}/$1" ]
}

check_gpu_dt_ready() {
  local failed=0

  if [ ! -d "${GPU_OF}" ]; then
    echo "FAIL: fb000000.gpu device-tree node is not present"
    return 1
  fi

  if dt_has_text compatible "rockchip,rk3588-mali" &&
     dt_has_text compatible "arm,mali-valhall-csf"; then
    echo "OK: compatible matches mainline panthor"
  else
    echo "FAIL: compatible must include rockchip,rk3588-mali and arm,mali-valhall-csf"
    failed=1
  fi

  case "$(dt_text_prop status 2>/dev/null || true)" in
    ""|okay)
      echo "OK: GPU DT status allows probing"
      ;;
    *)
      echo "FAIL: GPU DT status is not okay"
      failed=1
      ;;
  esac

  for name in core coregroup stacks; do
    if dt_has_text clock-names "${name}"; then
      echo "OK: clock-name ${name}"
    else
      echo "FAIL: missing clock-name ${name}"
      failed=1
    fi
  done

  for name in job mmu gpu; do
    if dt_has_text interrupt-names "${name}"; then
      echo "OK: interrupt-name ${name}"
    else
      echo "FAIL: missing interrupt-name ${name}"
      failed=1
    fi
  done

  for prop in mali-supply sram-supply operating-points-v2 power-domains; do
    if dt_has_prop "${prop}"; then
      echo "OK: ${prop} exists"
    else
      echo "FAIL: ${prop} is missing"
      failed=1
    fi
  done

  if find /proc/device-tree -path '*power-controller*' -name domain-supply -print -quit 2>/dev/null | grep -q .; then
    echo "OK: GPU/power-controller domain-supply is present"
  else
    echo "FAIL: power-controller domain-supply not found; rebuilt DTB may not be installed"
    failed=1
  fi

  return "${failed}"
}

show_status() {
  hr "kernel / modules"
  uname -a
  lsmod | grep -Ei 'panthor|panfrost|mali|drm' || true

  hr "GPU DT compatible"
  if [ -e "${GPU_OF}/compatible" ]; then
    dt_text_prop compatible
  else
    echo "fb000000.gpu compatible not found"
  fi

  hr "GPU DT status"
  if [ -e "${GPU_OF}/status" ]; then
    dt_text_prop status
  else
    echo "no status property"
  fi

  hr "GPU DT safety guard"
  check_gpu_dt_ready || true

  hr "GPU modalias / driver"
  cat "${GPU_DEV}/modalias" 2>/dev/null || true
  readlink -f "${GPU_DEV}/driver" 2>/dev/null || echo "fb000000.gpu has no bound driver"

  hr "GPU power-domain supply hints"
  for prop in mali-supply sram-supply operating-points-v2 power-domains clock-names interrupt-names; do
    [ -e "${GPU_OF}/${prop}" ] && echo "${GPU_OF}/${prop}"
  done
  find /proc/device-tree \( -path '*pd_gpu*' -o -path '*power-controller*' \) 2>/dev/null | grep -E 'pd_gpu|domain-supply|power-domain@12' | head -n 80 || true
  find /proc/device-tree -name domain-supply -print 2>/dev/null | sed -n '1,80p' || true

  hr "panthor modinfo"
  modinfo panthor 2>/dev/null | grep -E '^filename|^description|^alias' || echo "panthor module not found"

  hr "auto-load policy"
  grep -RIn 'panthor\|panfrost' /etc/modules-load.d /etc/modprobe.d 2>/dev/null || true

  hr "/dev/dri"
  ls -l /dev/dri 2>/dev/null || echo "/dev/dri not found"

  hr "dmesg hints"
  dmesg | grep -Ei 'panthor|panfrost|mali|gpu|fb000000|drm|opp|clock|clk|regulator|power|pm-domain|vdd_gpu|iommu|firmware|renderD' | tail -n 160 || true

  hr "quick result"
  if ls /dev/dri/renderD* >/dev/null 2>&1 && lsmod | grep -q '^panthor'; then
    echo "OK: panthor loaded and /dev/dri/renderD* exists. Mali-G610 3D entry is ready."
  elif check_gpu_dt_ready >/dev/null 2>&1; then
    echo "WARN: DT safety guard passes, but render node is not ready. panthor remains manual-only."
  else
    echo "BLOCKED: DT safety guard failed. Do not load panthor until the DTB is rebuilt and installed."
  fi
}

load_panthor() {
  hr "manual panthor load test"
  echo "This path can hard-freeze the board if GPU DT/power data is wrong."
  echo

  if ! check_gpu_dt_ready; then
    echo
    echo "Refusing to load panthor because the DT safety guard failed."
    echo "Rebuild the BSP/DTB first, then verify this command without 'load'."
    exit 2
  fi

  if [ "${EASEPI_R2_GPU_DANGEROUS_LOAD:-no}" != "yes" ]; then
    echo
    echo "Refusing to run modprobe panthor without explicit confirmation."
    echo "After connecting serial/log capture and accepting the freeze risk, run:"
    echo "  EASEPI_R2_GPU_DANGEROUS_LOAD=yes easepi-r2-gpu-check load"
    exit 2
  fi

  echo "Running: modprobe panthor"
  modprobe panthor || true
  sleep 2
  show_status
}

unload_panthor() {
  hr "unload panthor"
  modprobe -r panthor 2>/dev/null || true
  sleep 1
  show_status
}

enable_auto() {
  hr "enable panthor auto-load"

  if ! ls /dev/dri/renderD* >/dev/null 2>&1 || ! lsmod | grep -q '^panthor'; then
    if [ "${EASEPI_R2_GPU_ALLOW_AUTO:-no}" != "yes" ]; then
      echo "Refusing to enable auto-load before a successful manual panthor run."
      echo "Expected: panthor loaded and /dev/dri/renderD* exists."
      echo "Override only if you know why:"
      echo "  EASEPI_R2_GPU_ALLOW_AUTO=yes easepi-r2-gpu-check enable-auto"
      exit 2
    fi
  fi

  rm -f /etc/modprobe.d/99-easepi-r2-panthor-manual-only.conf
  mkdir -p /etc/modules-load.d
  cat > /etc/modules-load.d/easepi-r2-gpu.conf <<'EOC'
# EasePi-R2 / RK3588 Mali-G610 mainline GPU driver
panthor
EOC
  echo "Enabled. Reboot to test automatic panthor loading."
}

disable_auto() {
  hr "disable panthor auto-load"
  rm -f /etc/modules-load.d/easepi-r2-gpu.conf
  mkdir -p /etc/modprobe.d
  cat > /etc/modprobe.d/99-easepi-r2-panthor-manual-only.conf <<'EOC'
# Safety debug mode: prevent panthor from being auto-loaded by udev/modalias at boot.
# Explicit manual test still works with: modprobe panthor
blacklist panthor
EOC
  echo "Disabled. Reboot to verify the system starts without panthor auto-loading."
}

case "$MODE" in
  status|check)
    show_status
    ;;
  load|test|modprobe)
    load_panthor
    ;;
  unload|remove)
    unload_panthor
    ;;
  enable-auto)
    enable_auto
    ;;
  disable-auto)
    disable_auto
    ;;
  logs)
    dmesg | grep -Ei 'panthor|panfrost|mali|gpu|fb000000|drm|opp|clock|clk|regulator|power|pm-domain|vdd_gpu|iommu|firmware|renderD' | tail -n 240 || true
    ;;
  guard)
    hr "GPU DT safety guard"
    check_gpu_dt_ready
    ;;
  *)
    cat <<USAGE
Usage:
  easepi-r2-gpu-check status       # show GPU status, default
  easepi-r2-gpu-check guard        # verify DT properties before any panthor load
  easepi-r2-gpu-check load         # manually modprobe panthor and show result
  easepi-r2-gpu-check unload       # unload panthor if possible
  easepi-r2-gpu-check logs         # show GPU-related dmesg
  easepi-r2-gpu-check enable-auto  # remove panthor blacklist and auto-load at boot
  easepi-r2-gpu-check disable-auto # restore safe manual-only mode

Dangerous load requires:
  EASEPI_R2_GPU_DANGEROUS_LOAD=yes easepi-r2-gpu-check load
USAGE
    exit 1
    ;;
esac
